{{ if .work -}}
# DevPod Start maize-eba.devpod
Host maize-eba.devpod
    ForwardAgent yes
    LogLevel error
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
    ProxyCommand "/usr/local/bin/devpod" ssh --stdio --context default --user vscode maize-eba
    User vscode
# DevPod End maize-eba.devpod

